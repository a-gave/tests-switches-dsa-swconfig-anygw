#!/bin/bash

iface=$(ip a | grep enp |awk '{print $2}' | awk 'NR==1' | sed 's/:$//');
        # fixed iface
        # iface= "enp3s0";

echo "ping6 ff02::1%$iface ..."
ip=$(ping -i 1 -c 3 ff02::1%$iface | awk '/bytes from/{ print $4 }' | awk 'NR==2' | sed 's/:$//');

echo "Connecting to $ip ..."
ussh="ssh -o GlobalKnownHostsFile=/dev/null -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o CheckHostIp=no";
$ussh root@$ip

