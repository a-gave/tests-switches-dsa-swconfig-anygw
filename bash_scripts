#### lime-up6
 || ~ $ cat /usr/local/bin/lime-up6 
        #!/bin/bash
        # Install the provided sysupgrade file or `./firmware.bin` in the first host found connected via cable
        ip=$(ping -c 2 ff02::1%enp3s0 | awk '/bytes from/{ print $4 }' | awk 'NR==2' | sed 's/:$//');
        file= [ ! $1 == "" ] || file="firmware.bin";

        	uscp="scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null";
        	ussh="ssh -o GlobalKnownHostsFile=/dev/null -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o CheckHostIp=no";

        	$uscp ${file} root@\[$ip\]:/tmp && \
        	$ussh root@$ip "sysupgrade -n -F /tmp/${file}"
            